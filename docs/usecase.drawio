        <mxCell id="e8" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;dashed=1;html=1;fontSize=10;" edge="1" parent="1" source="uc2" target="uc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legend" value="CHÚ THÍCH:&lt;br&gt;• Hình người = actor (nằm NGOÀI ranh giới hệ thống)&lt;br&gt;• Hình elip = use case (nằm TRONG ranh giới)&lt;br&gt;• Đường liền = actor tham gia use case&lt;br&gt;• Mũi tên nét đứt &amp;lt;&amp;lt;extend&amp;gt;&amp;gt; = UC2 chỉ xảy ra khi UC1 không tìm thấy khách hàng&lt;br&gt;• Elip nét đậm = use case quan trọng nhất (UC7), đặc tả chi tiết trong báo cáo" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="620" width="560" height="110" as="geometry" /></mxCell>
      </root>
