# Sao chép tệp này thành .env rồi sửa giá trị cho máy của em:  cp .env.example .env
# Tệp .env thật KHÔNG được commit (đã chặn trong .gitignore).

# --- Máy chủ API ---
PORT=3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Cơ sở dữ liệu MySQL / MariaDB (XAMPP mặc định: user root, mật khẩu rỗng) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=warranty_intake

# --- Đăng nhập ---
# Chuỗi bí mật dùng để ký token. Đổi thành chuỗi ngẫu nhiên dài, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
TOKEN_TTL_HOURS=8
